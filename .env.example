# Copy to .env.local. Keep real credentials out of Git.
# Use staging credentials only. Production Supabase is blocked locally and in Preview.
# Leave model credentials blank for offline tests and browser fixtures.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Required for :free models. Other models default to fireworks.
OPENROUTER_PROVIDER=

# Optional: accounts, saved library and personal red lines.
# Staging project URL: https://dwjhkcgzrlbobdpzpley.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only key for short-lived password recovery authorization.
# Generate a different value for each environment with openssl rand -hex 32.
AUTH_RECOVERY_COOKIE_SECRET=
# Set only after branded Supabase email delivery works for a non-team address.
AUTH_EMAIL_DELIVERY_VERIFIED=

# Optional. At least 32 bytes. Enables guest report sign-in, drafting and saving.
REVIEW_CONTINUATION_SECRET=

# Server-only Formspree form ID. Set only after verifying the notification inbox.
FORMSPREE_FORM_ID=
# Set to true in production only after a synthetic submission reaches support.
FORMSPREE_SUPPORT_VERIFIED=
