# Copy to .env.local. Keep real credentials out of Git.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Required for :free models. Other models default to fireworks.
OPENROUTER_PROVIDER=

# Optional: accounts, saved library and personal red lines.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only key for short-lived password recovery authorization.
# Generate a different value for each environment with openssl rand -hex 32.
AUTH_RECOVERY_COOKIE_SECRET=

# Optional. At least 32 bytes. Enables guest report sign-in, drafting and saving.
REVIEW_CONTINUATION_SECRET=

# Server-only Formspree form ID. Set only after verifying the notification inbox.
FORMSPREE_FORM_ID=
